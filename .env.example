# Copy to apps/web/.env.local. Never commit real values.

# --- Required --------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random secret for session cookies, e.g. `openssl rand -base64 48`.
SESSION_SECRET=
# Credential signing key — generate with `pnpm identity:keygen`.
IDENTITY_SIGNING_KEY=
# Salt for hashing identity documents (any long random string).
KYC_HASH_SALT=

# --- Demo (optional) ---------------------------------------------------------
# Show the built-in demo staff logins in a production build (they are always on
# in development). Their password is public, so leave this off for real use.
NEXT_PUBLIC_DEMO_ACCOUNTS=

# --- Supabase (optional; without it records are kept in memory) -----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# HS256 JWT secret used to mint short-lived Realtime tokens for staff.
SUPABASE_REALTIME_JWT_SECRET=

# --- Blockchain anchoring (optional) ----------------------------------------
# Sepolia: set the Alchemy URL, a funded deployer key and the deployed addresses.
ALCHEMY_SEPOLIA_URL=
DEPLOYER_PRIVATE_KEY=
SEPOLIA_IDENTITY_REGISTRY_ADDRESS=
SEPOLIA_INCIDENT_REGISTRY_ADDRESS=
# Local Hardhat alternative.
CHAIN_RPC_URL=
CHAIN_ID=
ANCHOR_PRIVATE_KEY=
IDENTITY_REGISTRY_ADDRESS=
INCIDENT_REGISTRY_ADDRESS=

# --- AI (optional) -----------------------------------------------------------
# Sarvam: translation, speech and case briefs.
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
# OpenAI: clothing profile from a photo, and translation for non-Indian languages.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5
OPENAI_TEXT_MODEL=gpt-5

# --- Emergency-contact email via Resend (optional) ---------------------------
RESEND_API_KEY=
EMERGENCY_FROM_EMAIL=
# While using Resend's sandbox sender, set this to your own inbox to receive
# every alert there. Leave it empty once your sending domain is verified.
EMERGENCY_ALERT_RECIPIENT=

# --- Offline features (optional) -----------------------------------------------
# Shared key for BLE relay gateways (tools/ble-gateway) uploading SOS packets.
PRAHARI_MESH_GATEWAY_KEY=
# Tile server whose terms allow offline caching, e.g. https://maps.example.com/{z}/{x}/{y}.png
NEXT_PUBLIC_OFFLINE_TILE_TEMPLATE=
NEXT_PUBLIC_OFFLINE_TILE_ATTRIBUTION=
# NDMA SACHET hazard feed cache (no key needed).
HAZARD_ALERT_CACHE_TTL_MS=300000
