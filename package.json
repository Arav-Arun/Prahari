{
  "name": "prahari",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @prahari/web dev",
    "dev:web": "pnpm --filter @prahari/web dev",
    "build": "pnpm --filter @prahari/web build",
    "lint": "pnpm --filter @prahari/web lint",
    "contract:compile": "pnpm --filter @prahari/contracts compile",
    "contract:deploy:sepolia": "pnpm --filter @prahari/contracts deploy:sepolia",
    "identity:keygen": "node scripts/generate-identity-key.mjs",
    "mesh:demo": "pnpm --filter @prahari/web mesh:demo",
    "test": "pnpm --filter @prahari/web test",
    "staff:create": "node scripts/create-staff-user.mjs"
  },
  "packageManager": "pnpm@11.19.0"
}
